{%- comment -%} DOUCE: "Why filter your shower water?" centered header, image cards (skin / hair), fact tiles. {%- endcomment -%}
{%- assign cards = section.blocks | where: 'type', 'point' -%}
<section
  class="dc-section color-{{ section.settings.color_scheme }}{% if section.settings.accent_italic %} dc-accent-italic{% endif %}"
  style="--dc-pt: {{ section.settings.padding_top }}px; --dc-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="dc-container">
    <div class="dc-why__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="dc-why__pill">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="dc-heading dc-heading--l">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="dc-why__intro">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- if cards.size > 0 -%}
      <ul class="dc-why__cards dc-why__cards--{{ cards.size }}">
        {%- for block in cards -%}
          <li class="dc-why__card" {{ block.shopify_attributes }}>
            <div class="dc-media dc-why__img">
              {%- render 'douce-image',
                image: block.settings.image,
                sizes: '(min-width: 990px) 25vw, 50vw',
                placeholder: 'lifestyle-1'
              -%}
            </div>
            <div class="dc-why__card-body">
              <h3 class="dc-why__title">{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
.dc-why__head {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 18px;
  max-width: 720px;
  margin: 0 auto 44px;
}
.dc-why__head .dc-heading { margin: 0; line-height: 1.05; }
.dc-why__pill {
  margin: 0;
  padding: 6px 16px;
  border: 1px solid rgba(var(--color-foreground), 0.35);
  border-radius: 999px;
  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.dc-why__intro { font-size: 18px; line-height: 1.7; color: rgba(var(--color-foreground), 0.75); }
.dc-why__intro p { margin: 0; }
.dc-why__cards {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 24px;
  grid-template-columns: repeat(4, minmax(0, 1fr));
}
.dc-why__cards--1 { grid-template-columns: minmax(0, 320px); justify-content: center; }
.dc-why__cards--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 680px; margin-inline: auto; }
.dc-why__cards--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.dc-why__card { display: flex; flex-direction: column; gap: 18px; }
.dc-why__img { aspect-ratio: 1 / 1; border-radius: var(--dc-radius-xl); }
.dc-why__card-body { text-align: left; }
.dc-why__title { margin: 0 0 8px; font-size: 21px; line-height: 1.25; }
.dc-why__card p { margin: 0; font-size: 16px; line-height: 1.6; color: rgba(var(--color-foreground), 0.75); }
@media (max-width: 989px) {
  .dc-why__head { margin-bottom: 28px; }
  .dc-why__cards, .dc-why__cards--3, .dc-why__cards--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 14px; max-width: none; }
  .dc-why__title { font-size: 18px; }
  .dc-why__card p { font-size: 15px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "DOUCE why filter",
  "tag": "div",
  "class": "section-douce-why-filter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label (pill)", "default": "" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "<em>Unfiltered</em> water can leave you with:" },
    { "type": "richtext", "id": "text", "label": "Intro", "default": "<p>You use water on your skin and hair every day. A filter at the showerhead helps make that water gentler.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "accent_italic", "label": "Accent colour on italic words", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Image card",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Square works best. Use your own photo." },
        { "type": "text", "id": "title", "label": "Title", "default": "Dry, tight skin" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Chlorine can strip natural oils, leaving skin feeling dry and tight." }
      ]
    }
  ],
  "presets": [
    {
      "name": "DOUCE why filter",
      "blocks": [ { "type": "point" }, { "type": "point" }, { "type": "point" }, { "type": "point" } ]
    }
  ]
}
{% endschema %}
