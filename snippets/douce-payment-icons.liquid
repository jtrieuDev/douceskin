{%- comment -%}
  Payment method logos under the add-to-cart button. They come from the payment methods
  actually enabled in Shopify, so a method that is turned off is never shown.
  Renders nothing when no method is enabled.
{%- endcomment -%}
{%- if shop.enabled_payment_types.size > 0 -%}
  <div class="douce-pay">
    <ul class="douce-pay__list" role="list">
      {%- for type in shop.enabled_payment_types -%}
        {%- if type == 'klarna' -%}{%- continue -%}{%- endif -%}
        {%- capture douce_pay_icon -%}{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}{%- endcapture -%}
        {%- comment -%} The American Express artwork is drawn off-centre in Shopify's icon: shift it back into the middle. {%- endcomment -%}
        {%- if type == 'american_express' -%}
          {%- assign douce_pay_icon = douce_pay_icon | replace: 'd="M25.8662 6.33203', 'transform="translate(-7.5 0)" d="M25.8662 6.33203' -%}
        {%- endif -%}
        <li class="douce-pay__item">{{ douce_pay_icon }}</li>
      {%- endfor -%}
    </ul>
  </div>
  <style>
    .douce-pay{margin:1.2rem 0 1.6rem;text-align:center}
    .douce-pay__list{display:flex;flex-wrap:wrap;justify-content:center;gap:.6rem;margin:0;padding:0;list-style:none}
    .douce-pay__item{display:block;line-height:0}
    .douce-pay__item svg{width:3.8rem;height:2.4rem}
  </style>
{%- endif -%}
