{%- comment -%} DOUCE: "Why filter your shower water?" centered header, image cards (skin / hair), fact tiles. {%- endcomment -%}
{%- assign cards = section.blocks | where: 'type', 'point' -%}
<section
  class="dc-section color-{{ section.settings.color_scheme }}{% if section.settings.accent_italic %} dc-accent-italic{% endif %}"
  style="--dc-pt: {{ section.settings.padding_top }}px; --dc-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="dc-container">
    <div class="dc-why__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="dc-why__pill">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="dc-heading dc-heading--l">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    <div class="dc-why">
      <div class="dc-media dc-why__image">
        {%- render 'douce-image',
          image: section.settings.image,
          sizes: '(min-width: 990px) 40vw, 100vw',
          placeholder: 'lifestyle-1'
        -%}
      </div>
      <div class="dc-why__side">
        {%- if section.settings.text != blank -%}
          <div class="dc-why__intro">{{ section.settings.text }}</div>
        {%- endif -%}
      <ul class="dc-why__points">
        {%- for block in section.blocks -%}
          <li class="dc-why__point" {{ block.shopify_attributes }}>
            <span class="dc-why__bar" aria-hidden="true"></span>
            <div class="dc-why__point-text">
              <h3 class="dc-why__title">{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
            {%- if block.settings.image != blank -%}
              <div class="dc-why__thumb">
                {%- render 'douce-image', image: block.settings.image, sizes: '240px' -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.dc-why {
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  gap: 64px;
  align-items: center;
}
.dc-why__image { aspect-ratio: 1 / 1; max-height: 520px; width: 100%; border-radius: var(--dc-radius-xl); }
.dc-why__head { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px; max-width: 720px; margin: 0 auto 48px; }
.dc-why__head .dc-heading { margin: 0; line-height: 1.05; }
.dc-why__pill {
  margin: 0;
  padding: 6px 16px;
  border: 1px solid rgba(var(--color-foreground), 0.35);
  border-radius: 999px;
  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.dc-why__side { display: flex; flex-direction: column; justify-content: center; gap: 20px; }
.dc-why__intro { font-size: 18px; line-height: 1.7; color: rgba(var(--color-foreground), 0.75); }
.dc-why__intro p { margin: 0; }
.dc-why__points { list-style: none; margin: 0; padding: 0; width: 100%; display: flex; flex-direction: column; gap: 14px; }
.dc-why__point {
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 16px 16px 16px 0;
  background: rgba(var(--color-foreground), 0.04);
  border-radius: 16px;
  overflow: hidden;
}
.dc-why__bar { align-self: stretch; width: 5px; flex: 0 0 5px; background: rgb(var(--color-accent)); border-radius: 0 4px 4px 0; }
.dc-why__point-text { flex: 1 1 auto; min-width: 0; text-align: left; }
.dc-why__title { margin: 0 0 6px; font-size: 20px; line-height: 1.2; }
.dc-why__point p { margin: 0; font-size: 16px; line-height: 1.6; color: rgba(var(--color-foreground), 0.75); }
.dc-why__thumb { flex: 0 0 112px; width: 112px; height: 112px; border-radius: 14px; overflow: hidden; }
.dc-why__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
@media (max-width: 989px) {
  .dc-why { grid-template-columns: 1fr; gap: 32px; }
  .dc-why__head { margin-bottom: 28px; }
  .dc-why__image { max-height: none; aspect-ratio: 4 / 3; }
  .dc-why__thumb { flex-basis: 80px; width: 80px; height: 80px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "DOUCE why filter",
  "tag": "div",
  "class": "section-douce-why-filter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label (pill)", "info": "Optional." },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "<em>Unfiltered</em> water can leave you with:" },
    { "type": "richtext", "id": "text", "label": "Intro", "default": "<p>You use water on your skin and hair every day. A filter at the showerhead helps make that water gentler.</p>" },
    { "type": "image_picker", "id": "image", "label": "Large image", "info": "Big photo on the left (4:5 portrait works best). Use your own photo." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "accent_italic", "label": "Accent colour on italic words", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Card",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Small image", "info": "Optional. Square works best." },
        { "type": "text", "id": "title", "label": "Title", "default": "Dry, tight skin" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Chlorine can strip natural oils, leaving skin feeling dry and tight." }
      ]
    }
  ],
  "presets": [
    {
      "name": "DOUCE why filter",
      "blocks": [ { "type": "point" }, { "type": "point" }, { "type": "point" }, { "type": "point" } ]
    }
  ]
}
{% endschema %}
