{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "rating": {
          "type": "rating"
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price",
          "settings": {
            "douce_card": true,
            "douce_card_title": "One-time purchase",
            "douce_card_includes": ""
          }
        },
        "benefits": {
          "type": "icon-with-text",
          "settings": {
            "layout": "vertical",
            "icon_1": "none",
            "heading_1": "",
            "icon_2": "none",
            "heading_2": "",
            "icon_3": "none",
            "heading_3": ""
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "square"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "subtitle": {
          "type": "text",
          "settings": {
            "text": "Filtered showerhead",
            "text_style": "uppercase"
          }
        },
        "reassurance": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "lock",
            "heading_1": "Secure checkout",
            "icon_2": "truck",
            "heading_2": "Shipping to the US",
            "icon_3": "none",
            "heading_3": ""
          }
        },
        "why": {
          "type": "collapsible_tab",
          "settings": {
            "douce_under_gallery": true,
            "heading": "Why DOUCE",
            "icon": "leaf",
            "content": "<p>[Add your brand story here.]</p>"
          }
        },
        "benefits_tab": {
          "type": "collapsible_tab",
          "settings": {
            "douce_under_gallery": true,
            "heading": "Key Benefits",
            "icon": "check_mark",
            "content": "<p>[List only benefits you can support with evidence.]</p>"
          }
        },
        "filter_tab": {
          "type": "collapsible_tab",
          "settings": {
            "douce_under_gallery": true,
            "heading": "Filter Replacement",
            "icon": "recycle",
            "content": "<p>[Replacement interval and filter price \u2014 to confirm with the supplier.]</p>"
          }
        },
        "box_tab": {
          "type": "collapsible_tab",
          "settings": {
            "douce_under_gallery": true,
            "heading": "What's Included in the Box",
            "icon": "box",
            "content": "<p>[Exact box contents \u2014 to confirm with the supplier.]</p>"
          }
        }
      },
      "block_order": [
        "title",
        "subtitle",
        "rating",
        "variant_picker",
        "price",
        "benefits",
        "quantity_selector",
        "buy_buttons",
        "reassurance",
        "description",
        "why",
        "benefits_tab",
        "filter_tab",
        "box_tab"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail",
        "media_size": "medium",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 48,
        "padding_bottom": 48
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}
