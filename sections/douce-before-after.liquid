{%- comment -%} DOUCE: draggable before/after image comparison with text. {%- endcomment -%}
<section
  class="dc-section color-{{ section.settings.color_scheme }}{% if section.settings.accent_italic %} dc-accent-italic{% endif %}"
  style="--dc-pt: {{ section.settings.padding_top }}px; --dc-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="dc-container">
    <div class="dc-ba{% if section.settings.layout == 'image_right' %} dc-ba--reverse{% endif %}{% if section.settings.problem_text != blank or section.settings.solution_text != blank %} dc-ba--square{% endif %}">
      {%- if section.settings.image != blank -%}
        <div class="dc-ba__compare dc-ba__compare--static">
          {%- render 'douce-image',
            image: section.settings.image,
            sizes: '(min-width: 750px) 50vw, 100vw',
            placeholder: 'product-apparel-2'
          -%}
          {%- if section.settings.label_before != blank -%}
            <span class="dc-pill dc-ba__tag dc-ba__tag--before">{{ section.settings.label_before | escape }}</span>
          {%- endif -%}
          {%- if section.settings.label_after != blank -%}
            <span class="dc-pill dc-pill--dark dc-ba__tag dc-ba__tag--after">{{ section.settings.label_after | escape }}</span>
          {%- endif -%}
        </div>
      {%- else -%}
      <douce-compare class="dc-ba__compare">
        <div class="dc-ba__layer dc-ba__layer--before">
          {%- render 'douce-image',
            image: section.settings.image_before,
            sizes: '(min-width: 750px) 55vw, 100vw',
            placeholder: 'product-apparel-2'
          -%}
        </div>
        <div class="dc-ba__layer dc-ba__layer--after">
          {%- render 'douce-image',
            image: section.settings.image_after,
            sizes: '(min-width: 750px) 55vw, 100vw',
            placeholder: 'product-apparel-3'
          -%}
        </div>
        <div class="dc-ba__line" aria-hidden="true"></div>
        {%- if section.settings.label_before != blank -%}
          <span class="dc-pill dc-ba__tag dc-ba__tag--before">{{ section.settings.label_before | escape }}</span>
        {%- endif -%}
        {%- if section.settings.label_after != blank -%}
          <span class="dc-pill dc-pill--dark dc-ba__tag dc-ba__tag--after">{{ section.settings.label_after | escape }}</span>
        {%- endif -%}
        <input
          class="dc-ba__range"
          type="range"
          min="0"
          max="100"
          value="50"
          aria-label="{{ section.settings.slider_label | escape }}"
        >
        <div class="dc-ba__handle" aria-hidden="true">
          {{- 'icon-arrow.svg' | inline_asset_content -}}
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        </div>
      </douce-compare>
      {%- endif -%}

      <div class="dc-ba__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="dc-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="dc-heading dc-heading--m">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="dc-text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.problem_text != blank or section.settings.solution_text != blank -%}
          <div class="dc-ba__points">
            {%- if section.settings.problem_text != blank -%}
              <div class="dc-ba__point">
                <h3 class="dc-ba__point-title">{{ section.settings.problem_title | escape }}</h3>
                <div class="dc-text dc-text--s">{{ section.settings.problem_text }}</div>
              </div>
            {%- endif -%}
            {%- if section.settings.solution_text != blank -%}
              <div class="dc-ba__point">
                <h3 class="dc-ba__point-title">{{ section.settings.solution_title | escape }}</h3>
                <div class="dc-text dc-text--s">{{ section.settings.solution_text }}</div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.settings.note != blank -%}
          <p class="dc-note">{{ section.settings.note | escape }}</p>
        {%- endif -%}
        {%- render 'douce-button',
          label: section.settings.button_label,
          link: section.settings.button_link,
          style: section.settings.button_style,
          size: 'm'
        -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DOUCE before & after",
  "tag": "div",
  "class": "section-douce-before-after",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Single image", "info": "If set, shows this picture instead of the before/after slider." },
    { "type": "image_picker", "id": "image_before", "label": "Before image" },
    { "type": "image_picker", "id": "image_after", "label": "After image" },
    { "type": "text", "id": "label_before", "label": "Before label", "default": "Day 1" },
    { "type": "text", "id": "label_after", "label": "After label", "default": "Day 60" },
    { "type": "text", "id": "slider_label", "label": "Slider label (screen readers)", "default": "Compare before and after" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Before & after" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "This stayed out <em>of your shower.</em>" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Drag to compare the same PP filter on day one and after two months. Your water looked clear the whole time.</p>"
    },
    { "type": "text", "id": "problem_title", "label": "Problem title", "default": "The problem" },
    { "type": "richtext", "id": "problem_text", "label": "Problem text", "info": "Leave empty to hide." },
    { "type": "text", "id": "solution_title", "label": "Solution title", "default": "The solution" },
    { "type": "richtext", "id": "solution_text", "label": "Solution text", "info": "Leave empty to hide." },
    { "type": "text", "id": "note", "label": "Small print", "default": "Results vary with your local water. Photographed in a hard-water home." },
    { "type": "text", "id": "button_label", "label": "Button label", "info": "Leave empty to hide." },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Color scheme button" },
        { "value": "dark", "label": "Dark" },
        { "value": "secondary", "label": "Outline" }
      ],
      "default": "dark"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        { "value": "image_left", "label": "Left" },
        { "value": "image_right", "label": "Right" }
      ],
      "default": "image_left"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "accent_italic", "label": "Accent colour on italic words", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [
    {
      "name": "DOUCE before & after"
    }
  ]
}
{% endschema %}
