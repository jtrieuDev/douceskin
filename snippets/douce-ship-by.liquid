{%- comment -%}
  "Order today, ships by <next business day>" line shown above the add-to-cart button.
  The date is computed in US Eastern time, skipping Saturdays and Sundays (holidays are not handled).
  Keep it consistent with the Shipping policy (orders are processed within 1-2 business days).
{%- endcomment -%}
<p class="douce-ship-by" data-douce-ship-by hidden>Order today, ships by <strong></strong></p>
<style>
  .douce-ship-by{margin:0 0 1rem;font-size:1.4rem;line-height:1.4;color:rgb(var(--color-foreground));text-align:center}
  .douce-ship-by strong{font-weight:700}
</style>
<script>
  (function () {
    try {
      var tz = 'America/New_York';
      var p = new Intl.DateTimeFormat('en-US', { timeZone: tz, year: 'numeric', month: 'numeric', day: 'numeric' }).formatToParts(new Date());
      var v = {};
      p.forEach(function (x) { v[x.type] = parseInt(x.value, 10); });
      var d = new Date(Date.UTC(v.year, v.month - 1, v.day, 12));
      do { d.setUTCDate(d.getUTCDate() + 1); } while (d.getUTCDay() === 0 || d.getUTCDay() === 6);
      var label = new Intl.DateTimeFormat('en-US', { timeZone: 'UTC', weekday: 'short', month: 'short', day: 'numeric' }).format(d);
      document.querySelectorAll('[data-douce-ship-by]').forEach(function (el) {
        el.querySelector('strong').textContent = label;
        el.hidden = false;
      });
    } catch (e) {}
  })();
</script>
